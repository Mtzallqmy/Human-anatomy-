{
  "name": "human-anatomy-medical-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:vercel": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src app docs README.md",
    "format:check": "prettier --check src app docs README.md",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:seed:render": "node --import tsx scripts/render-supabase-seed.ts",
    "db:seed:stage4-5": "node --import tsx scripts/render-stage4-5-seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.3",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.12",
    "three": "^0.185.1",
    "zod": "4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Human Anatomy, Physiology & Pathology Atlas"
}
