# Public base URL used by production metadata when a canonical domain is configured.
NEXT_PUBLIC_SITE_URL=

# Optional future remote medical-content API.
NEXT_PUBLIC_MEDICAL_API_URL=

# Supabase browser-safe credentials. Use a modern sb_publishable_ key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional future external GLB/GLTF asset root.
NEXT_PUBLIC_MODEL_ASSET_BASE_URL=
